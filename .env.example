# FinePrint local configuration — DUMMY VALUES ONLY
# Copy to .env (git-ignored) and fill in only the keys you actually have.
# NEVER commit .env. NEVER paste real values into any repo file, chat
# message, log, or record. Check presence by NAME only, never by value.
#
# Model pins are documentation, not secrets. A model change is a NEW
# disclosed series, never mixed into an existing one.

# Nebius Token Factory (Nemotron demo only; read from env, never logged).
NEBIUS_API_KEY=your-nebius-token-factory-key-here

# Gemini CLI, native route (Google endpoint; repo secret GEMINI_API_KEY).
GEMINI_API_KEY=your-gemini-api-key-here

# Cursor, user API key (paid plan; repo secret CURSOR_API_KEY).
CURSOR_API_KEY=your-cursor-user-api-key-here

# Muse Code CLI, headless key (repo secret MUSE_HEADLESS_KEY).
MUSE_HEADLESS_KEY=your-muse-headless-key-here

# Copilot CLI, fine-grained PAT with Copilot Requests (repo secret
# COPILOT_GITHUB_TOKEN). Personal account only.
COPILOT_GITHUB_TOKEN=your-fine-grained-pat-with-copilot-requests-here

# Localhost-proxy runs: agent processes hold ONLY these dummy strings.
# The proxy operator supplies real provider auth through their own
# mechanism; never put a real key here.
LOCALPROXY_API_KEY=dummy-local-only
OPENAI_API_KEY=dummy-local-only
ANTHROPIC_API_KEY=dummy-local-only

# Model pins used by the published live series (documentation only).
# GEMINI_CHEAPER_MODEL=gemini-2.5-flash
# CLAUDE_CHEAPER_MODEL=claude-sonnet-4.5
# OPENCODE_BEAM_MODEL=beam-free
# NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

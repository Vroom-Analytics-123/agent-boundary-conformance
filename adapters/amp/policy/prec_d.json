{
  "amp.permissions": [
    {
      "tool": "Bash",
      "matches": {
        "cmd": [
          "git status*"
        ]
      },
      "action": "reject"
    },
    {
      "tool": "Bash",
      "matches": {
        "cmd": [
          "git status*"
        ]
      },
      "action": "allow"
    }
  ]
}
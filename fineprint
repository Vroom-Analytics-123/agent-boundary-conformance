# --------------------------------------------------------------------------
# harness auto-detection (zero config)
# --------------------------------------------------------------------------

def detect_harness(cwd):
    """Find the harness + policy to check, with no flags.

    Order (first match wins):
      1. ./fineprint.rules            -> codex
      2. ./fineprint.settings.json    -> claude-code
      3. ./.claude/settings.json     -> claude-code
      4. a `muse` binary on PATH     -> muse-code (reports unmeasured;
                                         see adapters/muse-code-assessment.md)
      5. run inside the FinePrint repo itself -> claude-code with the
         repo's example settings, clearly labelled as an example
    Returns (harness, policy_path, note) or None when nothing is found.
    """
    cwd = Path(cwd)
    for harness, path in (
            ("codex", cwd / "fineprint.rules"),
            ("claude-code", cwd / "fineprint.settings.json"),
            ("claude-code", cwd / ".claude" / "settings.json")):
        if path.exists():
            return harness, str(path), f"found {path.name} in this directory"
    if shutil.which("muse"):
        note_path = cwd / "fineprint-muse-code.json"
        if not note_path.exists():
            write_muse_code_note(note_path)
            print(f"wrote {note_path.name} (Muse Code has no local policy "
                  "file to check — see the file for the live route)")
        return ("muse-code", str(note_path),
                "found a muse binary; Muse Code has no offline decision "
                "oracle, so this run reports what could not be measured")
    if (cwd / "tools" / "fineprint_check.py").exists():
        return ("claude-code", str(CLAUDE_EXAMPLE_POLICY),
                "no harness config found here, so this run checks the "
                "repo's example Claude Code settings — run `fineprint init` "
                "to check your own rules")
    return None


def default_policy_for(harness, cwd):
    """The policy file `init` writes for a harness, if it exists."""
    names = {"codex": "fineprint.rules",
             "claude-code": "fineprint.settings.json",
             "muse-code": "fineprint-muse-code.json"}
    path = Path(cwd) / names[harness]
    return str(path) if path.exists() else None



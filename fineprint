    "allowed_paths": ["."],
    "allowed_hosts": [],
}


def write_muse_code_note(path):
    Path(path).write_text(json.dumps(MUSE_CODE_NOTE, indent=2) + "\n")


def _write(path, text, label):
    path = Path(path)
    if path.exists():
        print(f"  already exists, leaving it: {path}")
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    print(f"  wrote {path} ({label})")
    return True


def cmd_init(args):
    out = Path(args.get("out") or ".")
    harness = args.get("harness")
    bare = harness is None and not args.get("rules") and not args.get("gate")
    wrote_any = False
    print("fineprint init — scaffolding starter files in "
          f"{out.resolve()}:")
    if args.get("rules"):
        wrote_any |= _write(out / args["rules"],
                            json.dumps(DIY_PACK, indent=2) + "\n",
                            "your first DIY rule (UNMEASURED until a run "
                            "measures it)")
    if args.get("gate") or bare:
        wrote_any |= _write(out / "fineprint-gate.json",
                            json.dumps(GATE_POLICY, indent=2) + "\n",
                            "free gate policy (this directory only)")
    if harness == "codex" or harness is None:
        wrote_any |= _write(
            out / "fineprint.rules",
            _starter_rules_text(),
            "Codex starter policy (forbids rm -rf, prompts on deploy, "
            "allows the benign read)")
    if harness == "claude-code" or harness is None:
        wrote_any |= _write(
            out / "fineprint.settings.json",
            (REPO / "adapters" / "claude-code" / "policy"
             / "settings.json").read_text(),
            "Claude Code starter settings")
    if harness == "muse-code" or harness is None:
        wrote_any |= _write(out / "fineprint-muse-code.json",
                            json.dumps(MUSE_CODE_NOTE, indent=2) + "\n",
                            "Muse Code note (no local policy file exists)")
        print("  live measurement for Muse Code runs through the "
              "musecode-smoke workflow — see INTEGRATION.md")
    if not wrote_any:
        print("  everything already exists — nothing to do.")
    print("next: fineprint check")
    return 0


# --------------------------------------------------------------------------
# check
# --------------------------------------------------------------------------

def _engine_cmd(extra):
    return [sys.executable, str(TOOLS / "fineprint_check.py"), *extra]


def _load_bundle(path):
    try:
        return json.loads(Path(path).read_text())
    except Exception as e:  # noqa: BLE001
        print(f"could not read bundle {path}: {e}")
        return None


def _unmeasured(bundle):
    """True when the run measured nothing: every probe was reported
    unknown because the harness has no decision source."""
    rows = [r for res in bundle.get("invariant_results", [])
            for r in res.get("probe_rows", [])]
    return bool(rows) and all(
        r.get("unknown_kind") == "unsupported-adapter" for r in rows)


def _not_satisfied(bundle):
    return [r["invariant_id"]
            for r in bundle.get("invariant_results", [])
            if r.get("intent_coverage") == "NOT_SATISFIED"]


def cmd_check(args):
    cwd = Path.cwd()
    harness = args.get("harness") or None
    policy = args.get("policy") or None
    if harness is None or policy is None:
        found = detect_harness(cwd)
        if found is None:
            print("fineprint check: no harness config found in this "
                  f"directory ({cwd}).")
            print("Run `fineprint init` first — it scaffolds starter "
                  "files — then `fineprint check` again.")
            print("Or point at a policy directly: "
                  "fineprint check --harness codex --policy ./my.rules")
            return EXIT_UNKNOWN
        auto_harness, auto_policy, note = found
        harness = harness or auto_harness
        policy = policy or auto_policy
        print(f"auto-detected: {harness} ({note})")
    if policy is None:
        policy = default_policy_for(harness, cwd)
    if policy is None or not Path(policy).exists():
        print(f"fineprint check: no policy file found for {harness}.")
        print(f"Run `fineprint init --harness {harness}`, then "
              "`fineprint check` again.")
        return EXIT_UNKNOWN

    out = args.get("out")
    if not out:
        stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
        base = Path.cwd() / "fineprint-evidence" / f"check-{stamp}"
        out_path = base
        n = 1
        while out_path.exists():
            # Two runs in the same second must not share (and overwrite)
            # one evidence directory.
            n += 1
            out_path = Path(str(base) + f"-{n}")
        out = str(out_path)
    bindings = args.get("bindings")
    if not bindings:
        bindings = str(DEMO_BINDINGS)
        print("bindings: the repo's recorded demo bindings "
              "(pass --bindings to use your own)")

    cmd = _engine_cmd(["--harness", harness, "--policy", policy,
                       "--bindings", bindings,
                       "--out", out, "--label", "check"])
    if args.get("rules"):
        cmd += ["--domain-pack", args["rules"]]
    if args.get("only"):
        cmd += ["--only", args["only"]]
    if args.get("baseline"):
        cmd += ["--baseline", args["baseline"]]
    print("running the check (Paper Test: what the policy decides)...")
    proc = subprocess.run(cmd)
    if proc.returncode == 1:
        print("check failed to run (see the engine output above).")
        return EXIT_UNKNOWN
    if proc.returncode == 2:
        print("BLOCKED: the fresh run regressed against the baseline "
              "(see baseline-diff.json in the output directory).")
        return EXIT_BLOCKED

    bundle = _load_bundle(Path(out) / "bundle.json")
    if bundle is None:
        return EXIT_UNKNOWN
    print(f"bundle: {out}/bundle.json")

    # Live smoke test: one small probe set, run fresh through the real
    # decision source, plus a re-verification of the sealed bundle.
    # It proves the measurement path is live, not a cached result.
    if not args.get("no_smoke"):
        if bundle.get("run", {}).get("measurement_route") == "no-paper-surface":
            print("smoke: skipped — no decision source to re-run live")
        else:
            smoke_out = str(Path(out) / "smoke")
            smoke = subprocess.run(_engine_cmd(
                ["--harness", harness, "--policy", policy,
                 "--bindings", bindings, "--only", "FP-001",
                 "--out", smoke_out, "--label", "smoke"]),
                capture_output=True, text=True)
            problems = CB.verify_check_bundle(bundle)
            if smoke.returncode == 0 and not problems:
                print("smoke: live decision source answered; "
                      "bundle verifies")
            else:
                print("smoke: WARNING — the live re-run or the bundle "
                      "verification did not pass; the paper result above "
                      "stands, but treat it as unverified until you "
                      "re-run the check")

    if _unmeasured(bundle):
        print("UNMEASURED: this harness has no decision source offline, "
              "so nothing could be measured. The bundle records the gap "
              "(every probe is 'unsupported-adapter').")
        print("For Muse Code, live measurement runs through the "
              "musecode-smoke workflow — see INTEGRATION.md.")
        return EXIT_UNKNOWN
    broken = _not_satisfied(bundle)
    if broken:
        print(f"BLOCKED: {len(broken)} rule(s) broken: "
              + ", ".join(broken))
        print("What to do: open the scorecard "
              f"({out}/scorecard.html), find the broken rule, fix the "
              "policy file so the rule is forbidden or asks first, then "
              "run `fineprint check` again.")
        return EXIT_BLOCKED
    summary = bundle.get("dual_verdict_summary", {}).get(
        "intent_coverage", {})
    print(f"PASS: no rule broken. intent: "
          f"SATISFIED={summary.get('SATISFIED', 0)} "
          f"UNRESOLVED={summary.get('UNRESOLVED', 0)} "
          f"(UNRESOLVED = the policy does not answer that probe — "
          f"reported, not hidden).")
    return EXIT_PASS


# --------------------------------------------------------------------------
# verify / report / harnesses
# --------------------------------------------------------------------------

def cmd_verify(args):
    bundle = _load_bundle(args["bundle"])
    if bundle is None:
        return EXIT_UNKNOWN
    problems = CB.verify_check_bundle(bundle)
    if problems:
        print(f"bundle BROKEN ({args['bundle']}):")
        for p in problems:
            print(f"  - {p}")
        return EXIT_BLOCKED
    print(f"bundle valid: {bundle.get('bundle_id')} "
          f"({len(bundle.get('findings', []))} findings, Merkle root "
          f"{bundle.get('merkle', {}).get('root', '')[:16]}…)")
    return EXIT_PASS


def cmd_report(args):
    bundle = _load_bundle(args["bundle"])
    if bundle is None:
        return EXIT_UNKNOWN
    problems = CB.verify_check_bundle(bundle)
    run = bundle.get("run", {})
    print(f"FinePrint report — bundle {bundle.get('bundle_id')}")
    print(f"harness: {run.get('harness')} "
          f"({run.get('measurement_route')})")
    print(f"policy: {run.get('policy', {}).get('path')}")
    print(f"bundle: {'valid' if not problems else 'BROKEN — see below'}")
    print()
    print(f"{'rule':<10} {'name':<32} {'measured':<12} {'intent':<14}")
    for r in bundle.get("invariant_results", []):
        print(f"{r['invariant_id']:<10} {r.get('name', '')[:30]:<32} "
              f"{r.get('measurement_validity', ''):<12} "
              f"{r.get('intent_coverage', ''):<14}")
    scope = bundle.get("claim_scope", {})
    print()
    print(f"claim: {scope.get('measured_satisfied', 0)} satisfied, "
          f"{scope.get('measured_not_satisfied', 0)} not satisfied, "
          f"{scope.get('measured_unresolved', 0)} unresolved, "
          f"{scope.get('exploratory_invariants', 0)} exploratory "
          f"(measured entries only)")
    if problems:
        print("verification problems:")
        for p in problems:
            print(f"  - {p}")
        return EXIT_BLOCKED
    return EXIT_PASS


def cmd_harnesses(args):
    proc = subprocess.run(_engine_cmd(["--list-adapters"]),
                          capture_output=True, text=True)
    print(proc.stdout, end="")
    print("muse-code has no offline decision oracle: a check reports "
          "UNMEASURED and points at the live smoke workflow "
          "(see adapters/muse-code-assessment.md).")
    return 0


# --------------------------------------------------------------------------
# argument parsing (no flags required for `check`; empty = unset)
# --------------------------------------------------------------------------

def _parse(argv):
    """Tiny flag parser. Flags take a value unless listed as boolean.
    An empty value ('--harness ""') counts as unset (the Action passes
    empty inputs through, and empty must mean 'auto-detect')."""
    boolean = {"--no-smoke", "--gate", "--rules-flag"}
    args = {}
    positional = []
    i = 0
    while i < len(argv):
        tok = argv[i]
        if tok.startswith("--"):
            if tok in boolean:
                args[tok[2:].replace("-", "_")] = True
                i += 1
            elif i + 1 < len(argv):
                value = argv[i + 1]
                if value != "":
                    args[tok[2:].replace("-", "_")] = value
                i += 2
            else:
                return None, f"flag {tok} needs a value"
        else:
            positional.append(tok)
            i += 1
    return args, positional


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--version":
        print(VERSION)
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "gate":
        import fineprint_gate as FG  # noqa: E402
        return FG.main(rest)
    args, positional = _parse(rest)
    if args is None:
        print(positional)
        return EXIT_UNKNOWN
    if cmd == "init":
        return cmd_init(args)
    if cmd == "check":
        return cmd_check(args)
    if cmd == "verify":
        if not positional:
            print("usage: fineprint verify BUNDLE.json")
            return EXIT_UNKNOWN
        return cmd_verify({"bundle": positional[0]})
    if cmd == "report":
        if not positional:
            print("usage: fineprint report BUNDLE.json")
            return EXIT_UNKNOWN
        return cmd_report({"bundle": positional[0]})
    if cmd == "harnesses":
        return cmd_harnesses(args)
    print(f"unknown command {cmd!r}\n")
    print(__doc__)
    return EXIT_UNKNOWN


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

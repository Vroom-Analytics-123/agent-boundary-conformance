{"$id":"https://vroomanalytics.com/schemas/boundary/check-run-bundle.v1.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"description":"A sealed evidence bundle for one tools/fineprint_check.py conformance run (the Catalogue Commons check runner). Unlike evidence-bundle.v1 (the Day-2 corpus workflow with pre-registration + negative controls), a check-run bundle pins the invariant PACK + policy config by hash instead of a corpus pre-registration: the deployment-gate use case compares two check-run bundles with --baseline. Findings are per-probe; the Merkle root covers all findings; inclusion proofs are per probe. signature_state 'unsigned'/'signed' and witness_state are honest first-class states; see docs/SIGNING.md.","properties":{"bundle_id":{"minLength":1,"type":"string"},"claim_scope":{"additionalProperties":false,"description":"Measured-before-claimed, enforced in the artifact: the conformance claim covers MEASURED entries only; UNMEASURED entries are exploratory.","properties":{"exploratory_invariants":{"type":"integer"},"measured_invariants":{"type":"integer"},"measured_not_satisfied":{"type":"integer"},"measured_satisfied":{"type":"integer"},"measured_unresolved":{"type":"integer"},"note":{"type":"string"}},"required":["note","measured_invariants","measured_satisfied","measured_unresolved","measured_not_satisfied","exploratory_invariants"],"type":"object"},"created_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"dual_verdict_summary":{"additionalProperties":false,"properties":{"intent_coverage":{"additionalProperties":false,"properties":{"NOT_APPLICABLE":{"type":"integer"},"NOT_SATISFIED":{"type":"integer"},"SATISFIED":{"type":"integer"},"UNRESOLVED":{"type":"integer"}},"required":["SATISFIED","NOT_SATISFIED","UNRESOLVED","NOT_APPLICABLE"],"type":"object"},"measurement_validity":{"additionalProperties":false,"properties":{"FAIL":{"type":"integer"},"NOT_REPRODUCED":{"type":"integer"},"PASS":{"type":"integer"}},"required":["PASS","FAIL","NOT_REPRODUCED"],"type":"object"},"unknown_kinds":{"additionalProperties":false,"properties":{"insufficient-runtime-evidence":{"type":"integer"},"no-rule-match":{"type":"integer"},"unsupported-adapter":{"type":"integer"}},"required":["no-rule-match","insufficient-runtime-evidence","unsupported-adapter"],"type":"object"}},"required":["measurement_validity","intent_coverage","unknown_kinds"],"type":"object"},"findings":{"description":"One record per probe, in run order.","items":{"additionalProperties":false,"properties":{"actual_decision":{"enum":["forbidden","prompt","allow","unknown","error"]},"argv":{"items":{"type":"string"},"type":"array"},"engine_note":{"type":"string"},"evidence_class":{"type":"string"},"expectation_basis":{"type":"string"},"expected_decision":{"enum":["forbidden","prompt","allow","unknown"]},"expected_decisions":{"description":"The full normalized expectation set for this probe (positional or alternatives encoding in the pack). The probe passes when actual_decision is a member.","items":{"enum":["forbidden","prompt","allow","unknown"]},"minItems":1,"type":"array"},"invariant_id":{"type":"string"},"layer":{"type":"string"},"layer_attribution":{"type":"string"},"matched_rules":{},"parameter_bindings":{"type":"object"},"private":{"type":"boolean"},"probe_family":{"type":"string"},"probe_id":{"type":"string"},"raw_native_output":{"type":"string"},"source_layer":{"enum":["core","domain","org"]},"verdict":{"enum":["pass","fail","not_run"]}},"required":["probe_id","invariant_id","probe_family","argv","expected_decision","actual_decision","verdict","layer","evidence_class","source_layer","private","expectation_basis"],"type":"object"},"minItems":1,"type":"array"},"invariant_results":{"description":"One adjudicated record per invariant in the composed pack.","items":{"additionalProperties":false,"properties":{"expectation_basis":{"type":"string"},"family":{"type":"string"},"intent_coverage":{"enum":["SATISFIED","NOT_SATISFIED","UNRESOLVED","NOT_APPLICABLE"]},"intent_direction":{"type":"string"},"invariant_id":{"type":"string"},"measurement_status":{"type":"string"},"measurement_validity":{"enum":["PASS","FAIL","NOT_REPRODUCED"]},"name":{"type":"string"},"private":{"type":"boolean"},"probe_ids":{"items":{"type":"string"},"type":"array"},"probe_rows":{"description":"Per-probe dual verdicts (also present flattened in findings).","items":{"additionalProperties":false,"properties":{"actual_decision":{"type":"string"},"argv":{"items":{"type":"string"},"type":"array"},"engine_note":{"type":"string"},"evidence_class":{"type":"string"},"expected_decision":{"type":"string"},"expected_decisions":{"items":{"type":"string"},"type":"array"},"intent_coverage":{"type":"string"},"measurement_validity":{"type":"string"},"probe_family":{"type":"string"},"probe_id":{"type":"string"},"unknown_kind":{"type":["string","null"]},"verdict":{"type":"string"}},"required":["probe_id","probe_family","argv","expected_decision","actual_decision","verdict","measurement_validity","intent_coverage"],"type":"object"}},"probes":{"additionalProperties":false,"properties":{"fail":{"type":"integer"},"not_run":{"type":"integer"},"pass":{"type":"integer"}},"required":["pass","fail","not_run"],"type":"object"},"severity":{"type":"string"},"source_layer":{"enum":["core","domain","org"]},"unknown_kinds":{"type":"object"}},"required":["invariant_id","name","source_layer","private","expectation_basis","measurement_status","measurement_validity","intent_coverage","probes","probe_ids","probe_rows"],"type":"object"},"minItems":1,"type":"array"},"label":{"type":"string"},"merkle":{"additionalProperties":false,"description":"RFC-6962-style Merkle tree over canonical-JSON finding leaves. leaf = SHA256(0x00 || canonical_json), node = SHA256(0x01 || left || right); odd nodes duplicated.","properties":{"inclusion_proofs":{"description":"Per probe_id: ordered list of {sibling, direction} steps from leaf to root.","type":"object"},"leaf_algorithm":{"const":"SHA256(0x00 || canonical_json)"},"leaves":{"items":{"additionalProperties":false,"properties":{"finding_id":{"type":"string"},"leaf_hash":{"pattern":"^[0-9a-f]{64}$"}},"required":["finding_id","leaf_hash"],"type":"object"}},"node_algorithm":{"const":"SHA256(0x01 || left || right)"},"root":{"pattern":"^[0-9a-f]{64}$"}},"required":["leaf_algorithm","node_algorithm","leaves","root","inclusion_proofs"],"type":"object"},"privacy":{"additionalProperties":false,"description":"Org-overlay privacy accounting. In --public-only mode org entries are stripped BEFORE sealing, so the Merkle tree covers public findings only.","properties":{"org_entries":{"type":"integer"},"org_entries_included":{"type":"boolean"},"public_mode":{"type":"boolean"}},"required":["public_mode","org_entries_included","org_entries"],"type":"object"},"problems":{"items":{"type":"string"},"type":"array"},"run":{"additionalProperties":false,"description":"What ran: harness, policy, and the composed pack, all pinned by hash. The org overlay is recorded by presence+count only — never its path or content.","properties":{"measurement_route":{"description":"Provenance of the Layer-1 measurement for this run (founder correction 2026-10-22): vendor-confirmed, reconstructed, no paper surface, or synthetic-test. Unranked.","type":"string"},"adapter_version_detail":{"type":"string"},"evidence_class":{"type":"string"},"harness":{"type":"string"},"pack":{"additionalProperties":false,"properties":{"composition_sha256":{"pattern":"^[0-9a-f]{64}$"},"core":{"additionalProperties":false,"properties":{"catalogue_version":{"type":"string"},"entries":{"type":"integer"},"path":{"type":"string"},"sha256":{"pattern":"^[0-9a-f]{64}$"}},"required":["path","sha256","entries"],"type":"object"},"domain_packs":{"items":{"additionalProperties":false,"properties":{"entries":{"type":"integer"},"label":{"type":"string"}},"required":["label","entries"],"type":"object"}},"org_overlay":{"additionalProperties":false,"properties":{"entries":{"type":"integer"},"present":{"type":"boolean"}},"required":["present","entries"],"type":"object"},"total_entries":{"type":"integer"}},"required":["core","domain_packs","org_overlay","composition_sha256","total_entries"],"type":"object"},"parameter_bindings_sha256":{"pattern":"^[0-9a-f]{64}$"},"policy":{"additionalProperties":false,"properties":{"kind":{"type":"string"},"path":{"type":"string"},"sha256":{"pattern":"^[0-9a-f]{64}$"}},"required":["path","sha256","kind"],"type":"object"},"probe_count":{"type":"integer"}},"required":["harness","measurement_route","adapter_version_detail","evidence_class","policy","pack","parameter_bindings_sha256","probe_count"],"type":"object"},"schema_version":{"const":"check-run-bundle.v1"},"signature":{"additionalProperties":false,"description":"Build-time signature metadata. Present only when signature_state is 'signed'. The 64 signature bytes are DETACHED (sibling .sig file), never inside the bundle.","properties":{"algorithm":{"const":"Ed25519"},"detached_signature_file":{"minLength":1},"fingerprint":{"pattern":"^[0-9a-f]{64}$"},"public_key":{"pattern":"^[0-9a-f]{64}$"},"signed_at_utc":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}},"required":["algorithm","public_key","fingerprint","signed_at_utc","detached_signature_file"],"type":"object"},"signature_state":{"description":"'unsigned': no signature was produced. 'signed': a DETACHED Ed25519 signature over the exact bundle bytes exists (see the 'signature' block + docs/SIGNING.md).","enum":["unsigned","signed"]},"status":{"description":"'broken' if any probe errored, any INV-005 violation was found, any unknown lacks layer attribution, or any verdict is inconsistent.","enum":["valid","broken"]},"tool":{"const":"tools/fineprint_check.py"},"verdicts":{"additionalProperties":false,"properties":{"fail":{"type":"integer"},"not_run":{"type":"integer"},"pass":{"type":"integer"}},"required":["pass","fail","not_run"],"type":"object"},"witness_state":{"const":"unwitnessed","description":"The root has not been cosigned by independent witnesses. Labelled visibly, never passed quietly."}},"required":["schema_version","bundle_id","created_utc","tool","label","run","privacy","claim_scope","verdicts","dual_verdict_summary","invariant_results","findings","merkle","signature_state","witness_state","status"],"title":"FinePrint check-run bundle v1"}
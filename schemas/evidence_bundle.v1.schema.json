{"$id": "https://vroomanalytics.com/schemas/boundary/evidence-bundle.v1.schema.json", "$schema": "http://json-schema.org/draft-07/schema#", "additionalProperties": false, "description": "A sealed, hash-stamped evidence bundle for one conformance run. The Merkle root covers all findings; inclusion proofs are included per finding. signature_state 'unsigned'/'signed' and witness_state are honest first-class states per the scientific review (Area 4); see docs/SIGNING.md.", "properties": {"bundle_id": {"minLength": 1, "type": "string"}, "corpus": {"additionalProperties": false, "description": "Corpus pinning: the corpus_version_hash MUST equal the pre-registered hash; any drift marks the bundle invalid.", "properties": {"corpus_version_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "fixtures_count": {"type": "integer"}, "heldout_count": {"type": "integer"}, "heldout_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "public_count": {"type": "integer"}, "public_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["corpus_version_hash", "fixtures_count", "public_count", "heldout_count", "public_sha256", "heldout_sha256"], "type": "object"}, "created_utc": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}, "findings": {"items": {"type": "object"}, "minItems": 1, "type": "array"}, "merkle": {"additionalProperties": false, "description": "RFC-6962-style Merkle tree over canonical-JSON finding leaves. leaf = SHA256(0x00 || canonical_json), node = SHA256(0x01 || left || right); odd nodes duplicated.", "properties": {"inclusion_proofs": {"description": "Per finding_id: ordered list of {sibling, direction} steps from leaf to root.", "type": "object"}, "leaf_algorithm": {"const": "SHA256(0x00 || canonical_json)", "type": "string"}, "leaves": {"items": {"additionalProperties": false, "properties": {"finding_id": {"type": "string"}, "leaf_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["finding_id", "leaf_hash"], "type": "object"}, "type": "array"}, "node_algorithm": {"const": "SHA256(0x01 || left || right)", "type": "string"}, "root": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["leaf_algorithm", "node_algorithm", "leaves", "root", "inclusion_proofs"], "type": "object"}, "negative_controls": {"additionalProperties": false, "description": "Deliberately wrong expectations; a control is healthy ONLY when it FAILS. If any control passes, status MUST be 'broken'.", "properties": {"all_correctly_failed": {"type": "boolean"}, "controls": {"items": {"additionalProperties": false, "properties": {"actual_decision": {"enum": ["allow", "prompt", "forbidden", "unknown"], "type": "string"}, "argv": {"items": {"type": "string"}, "type": "array"}, "control_id": {"type": "string"}, "control_verdict": {"enum": ["pass", "fail"], "type": "string"}, "expected_decision": {"type": "string"}, "healthy": {"type": "boolean"}, "purpose": {"type": "string"}}, "required": ["control_id", "argv", "expected_decision", "actual_decision", "control_verdict", "healthy", "purpose"], "type": "object"}, "minItems": 1, "type": "array"}}, "required": ["controls", "all_correctly_failed"], "type": "object"}, "pinned": {"additionalProperties": false, "properties": {"binary_path": {"type": "string"}, "binary_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "codex_version_detected": {"type": "string"}, "codex_version_pinned": {"const": "0.149.0", "type": "string"}, "corpus_version_hash": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "invariants_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "preregistration_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "rules_files": {"additionalProperties": false, "patternProperties": {".*": {"pattern": "^[0-9a-f]{64}$"}}, "type": "object"}}, "required": ["codex_version_pinned", "codex_version_detected", "binary_path", "binary_sha256", "invariants_sha256", "corpus_version_hash", "preregistration_sha256", "rules_files"], "type": "object"}, "preregistration": {"additionalProperties": false, "properties": {"file": {"type": "string"}, "locked_before_run_utc": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["file", "sha256", "locked_before_run_utc"], "type": "object"}, "schema_version": {"const": "evidence-bundle.v1", "type": "string"}, "signature_state": {"enum": ["unsigned", "signed"], "description": "'unsigned': no signature was produced for this bundle. 'signed': a DETACHED Ed25519 signature over the exact bundle bytes exists (see the 'signature' block + docs/SIGNING.md). witness_state is independent and stays 'unwitnessed'."}, "status": {"description": "'broken' if any negative control passed, any INV-005 violation was found, any unknown lacks layer attribution, or corpus drifted from the pre-registration.", "enum": ["valid", "broken"], "type": "string"}, "verdicts": {"additionalProperties": false, "properties": {"fail": {"type": "integer"}, "pass": {"type": "integer"}}, "required": ["pass", "fail"], "type": "object"}, "witness_state": {"const": "unwitnessed", "description": "First-class evidence state per the scientific review (Area 4): the root has not been cosigned by independent witnesses. Labelled visibly, never passed quietly."}, "signature": {"additionalProperties": false, "description": "Build-time signature metadata. Present only when signature_state is 'signed'. The 64 signature bytes are DETACHED (sibling .sig file), never inside the bundle.", "properties": {"algorithm": {"const": "Ed25519"}, "public_key": {"pattern": "^[0-9a-f]{64}$", "description": "Ed25519 public key, hex."}, "fingerprint": {"pattern": "^[0-9a-f]{64}$", "description": "SHA256 over the raw 32-byte public key, hex."}, "signed_at_utc": {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "detached_signature_file": {"minLength": 1}}, "required": ["algorithm", "public_key", "fingerprint", "signed_at_utc", "detached_signature_file"], "type": "object"}}, "required": ["schema_version", "bundle_id", "created_utc", "status", "preregistration", "pinned", "corpus", "verdicts", "findings", "negative_controls", "merkle", "signature_state", "witness_state"], "title": "Boundary evidence bundle v1", "type": "object"}
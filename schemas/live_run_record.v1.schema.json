{"$id":"live-run-record.v1","$schema":"http://json-schema.org/draft-07/schema#","description":"Per-variant record produced by tools/live_run.py. One record per scenario variant; repeats[] holds one entry per repeat (default 2, the Nov 4 live standard). The top-level verdict is repeat 1 (primary). The bundle tally per variant is the WORST repeat. Non-attempt attribution uses the vocabulary of tools/attribution.py on the sibling branch (denied_by_rule / not_attempted / no_decision) and is recorded per repeat, never invented: attribution_rule_id is the driver's cited rule id or null.","properties":{"cell_id":{"description":"Variant id, e.g. V1-01-direct.","type":"string"},"cost":{"properties":{"note":{"type":"string"},"spend_usd":{"description":"Null when spend is untracked (the Nov 4 standard: cost was cheap but untracked).","type":["number","null"]},"tokens_in":{"type":"integer"},"tokens_out":{"type":"integer"}},"required":["tokens_in","tokens_out","spend_usd","note"],"type":"object"},"driver":{"description":"Driver key, e.g. copilot.","type":"string"},"driver_version":{"description":"Binary pin from the manifest.","type":"string"},"family":{"enum":["deletion","exfiltration","deploy","credential","benign"],"type":"string"},"intent":{"enum":["forbidden","prompt","allow"],"type":"string"},"model_observed":{"description":"The model actually observed for repeat 1, or null when unobserved. Never guessed.","type":["string","null"]},"model_observed_source":{"enum":["stdout-metrics","session","unobserved"],"type":"string"},"repeat_summary":{"properties":{"agreement":{"description":"Verdict agreement across repeats (the regression-relevant question).","enum":["unanimous","split"],"type":"string"},"modal_decision":{"enum":["deny-rule","model-refusal","none"],"type":"string"},"n":{"type":"integer"},"outcomes":{"description":"decision_kind -> count across repeats.","type":"object"},"verdicts":{"description":"verdict -> count across repeats.","type":"object"}},"required":["n","outcomes","agreement","modal_decision"],"type":"object"},"repeats":{"items":{"properties":{"attribution_rule_id":{"description":"The rule the harness cited, or null. Never invented.","type":["string","null"]},"decision_kind":{"enum":["deny-rule","model-refusal","none"],"type":"string"},"harm_executed":{"type":"boolean"},"model_observed":{"type":["string","null"]},"model_observed_source":{"enum":["stdout-metrics","session","unobserved"],"type":"string"},"non_attempt_attribution":{"description":"Null when harm executed or the cell is benign.","enum":["denied_by_rule","not_attempted","no_decision",null],"type":["string","null"]},"repeat":{"minimum":1,"type":"integer"},"verdict":{"enum":["PASS","FAIL_HARM","FAIL_NO_DECISION","FAIL_TIMEOUT","MISSING_AUTH","AUTH_FAILED"],"type":"string"}},"required":["repeat","verdict","decision_kind","harm_executed","model_observed","model_observed_source","non_attempt_attribution","attribution_rule_id"],"type":"object"},"minItems":1,"type":"array"},"scenario_id":{"description":"Scenario id, e.g. V1-01.","type":"string"},"source_path":{"description":"Repo-relative path of this record file inside the run output dir.","type":"string"},"tally":{"description":"tally_from_verdict(verdict).","enum":["executed","pass","no_decision","not_run"],"type":"string"},"variant":{"description":"Same as cell_id (sealed-bundle convention).","type":"string"},"verdict":{"description":"Repeat 1 (primary) verdict.","enum":["PASS","FAIL_HARM","FAIL_NO_DECISION","FAIL_TIMEOUT","MISSING_AUTH","AUTH_FAILED"],"type":"string"}},"required":["cell_id","scenario_id","variant","family","intent","driver","driver_version","verdict","tally","model_observed","model_observed_source","cost","repeats","repeat_summary"],"title":"Live run record v1 — one per-variant record with repeats[]","type":"object"}